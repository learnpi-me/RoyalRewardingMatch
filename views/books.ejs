<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link
    rel="stylesheet"  href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
  />
    <title>Books</title>
    <style>
        body {
            font-family: sans-serif;
            margin:0;
            padding:0;
            background:black;
        }
       .header{
           width:100%;
           min-height:60px;
           display:flex;
           justify-content:space-between;
           align-items:center;
           border:solid #6B6B6B;
           background: #1F1F1F;
           flex-wrap:wrap;
           gap:10px;
           padding:8px 15px;
       }
       
       .my-element {
           display: inline-block;
           margin: 5px;
           scale: 1.2;
           --animate-duration: 2s;
       }
       
       .header-brand {
           flex: 0 1 auto;
           min-width: 120px;
       }
       
       .header-brand h3 {
           font-size: 1.1em !important;
       }
       
       @media (max-width: 768px) {
           .header {
               padding: 5px 10px;
               gap: 5px;
               min-height: 50px;
           }
           
           .my-element {
               scale: 1;
               margin: 2px;
           }
           
           .header-brand {
               min-width: 100px;
           }
           
           .header-brand h3 {
               font-size: 0.9em !important;
           }
       }
       
       @media (max-width: 480px) {
           .header {
               justify-content: center;
               text-align: center;
           }
           
           .header-brand {
               min-width: 80px;
           }
           
           .header-brand h3 {
               font-size: 0.8em !important;
           }
       }
    </style>
</head>
<body>
<div class="header">
    
 <div class="header-brand" style="
     margin:5px; position: relative; display: flex; align-items: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%); padding: 5px 15px; border-radius: 10px; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); overflow: hidden;">
          <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.15) 0%, transparent 50%); pointer-events: none;"></div>
          <h3 style="position: relative; color: white; margin: 0; font-size: 1.3em; text-shadow: 1px 1px 3px rgba(0,0,0,0.3); font-weight: 600; letter-spacing: -0.5px;">LearnPulse</h3>
 </div> 
  <span class="my-element animate__animated animate__heartBeat animate__infinite">💖</span> 
 <div class="header-brand" style="
     margin:5px; position: relative; display: flex; align-items: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%); padding: 5px 15px; border-radius: 10px; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); overflow: hidden;">
          <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.15) 0%, transparent 50%); pointer-events: none;"></div>
          <h3 style="position: relative; color: white; margin: 0; font-size: 1.3em; text-shadow: 1px 1px 3px rgba(0,0,0,0.3); font-weight: 600; letter-spacing: -0.5px;">LitLooms</h3>
 </div>
    
</div>
    <script>
       
    </script>
</body>
</html>