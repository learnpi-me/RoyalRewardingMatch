<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link
    rel="stylesheet"  href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css"
  />
    <title>Books</title>
    <style>
        body {
            font-family: sans-serif;
            margin:0;
            padding:0;
            background:black;
        }
       .header{
           width:100%;
           height:8%;
           display:flex;
           justify-content:space-between;
border:solid #6B6B6B;
           background: #1F1F1F;
       }
        .my-element {
  display: inline-block;
  margin: 0 0.5rem;
margin:20px;
        scale:1.4;
  animation: heartBeat; /* referring directly to the animation's @keyframe declaration */
  animation-duration: 2s; /* don't forget to set a duration! */
  --animate-repeat: 200;
            
        }
    </style>
</head>
<body>
<div class="header">
 <div style="
     margin:10px;position: relative; display: flex; align-items: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%); padding: 8px 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); overflow: hidden;">
          <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.15) 0%, transparent 50%); pointer-events: none;"></div>
          <h3 style="position: relative; color: white; margin: 0; font-size: 1.3em; text-shadow: 1px 1px 3px rgba(0,0,0,0.3); font-weight: 600; letter-spacing: -0.5px;">LearnPulse</h3>
 </div> 
  <span class="my-element animate__infinite ">💖</span> 
 <div style="
     margin:10px; position: relative; display: flex; align-items: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%); padding: 8px 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); overflow: hidden; width:100px; height:80%;">
          <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.15) 0%, transparent 50%); pointer-events: none;"></div>
          <h3 style="position: relative; color: white; margin: 0; font-size: 1.3em; text-shadow: 1px 1px 3px rgba(0,0,0,0.3); font-weight: 600; letter-spacing: -0.5px;">LitLooms</h3>
 </div>   
</div>
    <script>
       
    </script>
</body>
</html>