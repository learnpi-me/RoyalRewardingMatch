<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Books</title>
    <style>
        body {
            font-family: sans-serif;
            margin:0;
            padding:0;
            background:black;
        }
       .header{
           width:100%;
           display:flex;
           justify-content:space-between;
background:#1F1F1F;
    border:solid 1px white;
        padding:12px;
       }
    </style>
</head>
<body>
<div class="header">
 <div style="
     margin;position: relative; display: flex; align-items: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%); padding: 8px 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); overflow: hidden;">
          <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.15) 0%, transparent 50%); pointer-events: none;"></div>
          <h3 style="position: relative; color: white; margin: 0; font-size: 1.3em; text-shadow: 1px 1px 3px rgba(0,0,0,0.3); font-weight: 600; letter-spacing: -0.5px;">LearnPulse</h3>
 </div>   
</div>
    
        <script src="p5.min.js"></script>
        <script src="vanta.topology.min.js"></script>
        <script>
        VANTA.TOPOLOGY({
          el: "#body",
          mouseControls: true,
          touchControls: true,
          gyroControls: false,
          minHeight: 200.00,
          minWidth: 200.00,
          scale: 1.00,
          scaleMobile: 1.00,
          color: 0x8e8e8d,
          backgroundColor: 0x0
        })
            </script>
    </script>
