<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Books - LearnPulse</title>
    <style>
    *,*::before,
*::after {
    box-sizing: border-box; /* This is the fix! */
}    
        /* Minimalist CSS */
        body {
            font-family: sans-serif;
            margin: 0;
            padding: 0;
            /* Remove background to allow Vanta.js effect */
            min-height:100vh;
            width:100vw;
            position: relative;
        }

        /* Fixed Background */
    

        /* Header */
        .header {
            width: 100%;
            display: flex;
            justify-content: center;
            background: rgba(31, 31, 31, 0.9);
            border-bottom: solid 1px white;
            padding: 10px;
            z-index: 10; /* Highest Z-index */
        }

        /* Logo Styling */
        .logo {
            display: flex;
            align-items: center;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%);
            padding: 8px 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
            overflow: hidden;
            position: relative; /* Needed for the ::before pseudo-element */
        }

        /* Logo Shine Effect */
        .logo::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.15) 0%, transparent 50%);
            pointer-events: none;
        }

        .logo h3 {
            position: relative;
            color: white;
            margin: 0;
            font-size: 1.3em;
            font-weight: 600;
        }
       .books{
           margin-top:20px;
        display:flex;
       flex-wrap:wrap;
        padding:12px;
       }
      .book{
          background:black;
              width:100%;
          height:60px;
      }.card{
        background: rgba(0,0,0,0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 15px;
        padding: 5px;
        max-width: 400px;
        width: 100%;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        position: relative;
        z-index: 10;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.4);
    }
    
    .title{
        font-size: 16px;
        margin:12px;
        color: white;
        font-weight: 500;
        line-height: 1.4;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        letter-spacing: 0.5px;
    }
        .card p{
            color:rgba(255,255,255,0.7);
            text-align: left;
            margin-top: 9px;
            margin-bottom: 20px;
            font-size: 14px;
            line-height: 1.5;
        }
        
        .card a{
            display: inline-block;
            width:97%;
            color: white;
            font-size: 16px;
            font-weight: 600;
            padding: 10px 10px;
            margin: 5px 5px;
background: #2563EB;
            border: 1px solid rgba(255,255,255,0.3);
            border-radius: 5px;
            text-decoration: none;
            text-align: center;
            backdrop-filter: blur(5px);
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            user-select: none; -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        
        .card a:hover {
            background: linear-gradient(135deg, rgba(255,255,255,0.25), rgba(255,255,255,0.1));
            border-color: rgba(255,255,255,0.6);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
            color: white;
        }
        
        .card a:active {
            transform: translateY(0);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        .wrapper{
 display:flex;
justify-content:space-around;
        }
            
    </style>
</head>
<body>

    <div class="header">
        <div class="logo">
            <h3>LearnPulse</h3>
        </div>   
    </div>
<div class="books">
    <div class="card">
        <h3 class="title">
            Unbarbad
        </h3>              <div class="wrapper">
        <p>Author : Shobhit Nirwan</p>
     <p>Class : 10</p>   
        </div>
        <a href="#">Download</a>
    </div>
    <% books.forEach((book) => { %>
    <div class="card">
        <h3 class="title"><%= book.title %></h3>
        <div class="wrapper">
            <p>Author: <%= book.author %></p>
            <p>Category: <%= book.category %></p>
        </div>
        <a href="#">Download</a>
    </div>
<% }) %>
</div>
 <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r121/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.topology.min.js"></script>
<script>
// Wait for page to load before initializing Vanta
window.addEventListener('load', function() {
    try {
        VANTA.TOPOLOGY({
            el: "body",
            mouseControls: true,
            touchControls: true,
            gyroControls: false,
            minHeight: 200.00,
            minWidth: 200.00,
            scale: 1.00,
            scaleMobile: 1.00,
            color: 0x3f7cac,
            backgroundColor: 0x0
        });
        console.log("Vanta.js initialized successfully");
    } catch (error) {
        console.error("Failed to initialize Vanta.js:", error);
    }
});
</script>
</body>
</html>