
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Books</title>
    <style>
        body {
            font-family: sans-serif;
            margin: 0;
            padding: 0;
            background: black;
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
        }
        
        #vanta-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
        }
        
        .header {
            width: 100%;
            display: flex;
            justify-content: space-between;
            background: #1F1F1F;
            border: solid 1px white;
            padding: 12px;
            position: relative;
            z-index: 10;
        }
        
        .content {
            position: relative;
            z-index: 5;
            padding: 20px;
        }
        
        .book-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        
        .book-card {
            background: rgba(31, 31, 31, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            padding: 15px;
            color: white;
            backdrop-filter: blur(10px);
        }
        
        .book-title {
            font-size: 1.2em;
            font-weight: bold;
            margin-bottom: 10px;
        }
        
        .book-author {
            color: #ccc;
            font-size: 0.9em;
        }
    </style>
</head>
<body>
    <div id="vanta-bg"></div>
    
    <div class="header">
        <div style="position: relative; display: flex; align-items: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%); padding: 8px 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); overflow: hidden;">
            <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.15) 0%, transparent 50%); pointer-events: none;"></div>
            <h3 style="position: relative; color: white; margin: 0; font-size: 1.3em; text-shadow: 1px 1px 3px rgba(0,0,0,0.3); font-weight: 600; letter-spacing: -0.5px;">LearnPulse</h3>
        </div>   
    </div>
    
    <div class="content">
        <h1 style="color: white; text-align: center; margin-bottom: 30px;">Books Library</h1>
        
        <% if (typeof books !== 'undefined' && books.length > 0) { %>
            <div class="book-grid">
                <% books.forEach(book => { %>
                    <div class="book-card">
                        <div class="book-title"><%= book.title %></div>
                        <div class="book-author">by <%= book.author %></div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <p style="color: white; text-align: center;">No books available at the moment.</p>
        <% } %>
    </div>
    
    <script src="https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.4.0/p5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.topology.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof VANTA !== 'undefined') {
                VANTA.TOPOLOGY({
                    el: "#vanta-bg",
                    mouseControls: true,
                    touchControls: true,
                    gyroControls: false,
                    minHeight: 200.00,
                    minWidth: 200.00,
                    scale: 1.00,
                    scaleMobile: 1.00,
                    color: 0x8e8e8d,
                    backgroundColor: 0x0
                });
            }
        });
    </script>
</body>
</html>
