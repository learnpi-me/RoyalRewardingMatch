<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Management System</title>
    <style>
        body {
            /* Vanta fix: ensures the body covers the entire viewport */
            background-color: black;
            margin: 0; 
            padding: 0;
            min-height: 100vh; 
            width: 100vw;
        }

        /* Set a z-index on content containers to ensure they appear above Vanta */
        .header, .selector {
            position: relative; /* Necessary to use z-index */
            z-index: 10; /* Ensures content is layered above the Vanta canvas */
        }
        
        .header {
            padding-top: 20px;
        }
        
        h3 {
            text-align: center;
            font-family: 'Arial', sans-serif;
            font-size: 20px;
            color: white;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
            margin: 0;
            margin-bottom: 20px;
        }
        
        .selector {
            width: 100%;
            min-width: 250px;
            max-width: 300px;
            height: 72px;
            display: flex;
            justify-content: space-between;
            padding: 10px;
            /* Center the selector element horizontally */
            margin-left: auto; 
            margin-right: auto;
        }
        
        .btn {
            padding: 7px;
            background: #454545;
            display: flex;
            justify-content: center;
            outline: none;
            -webkit-tap-highlight-color: transparent;
            align-items: center;
            height: 30px;
            border-radius: 10px;
            cursor: pointer;
            transition: background 0.3s;
        }

        .btn:hover {
            background: #606060;
        }
        
        .btn p {
            color: white;
            font-size: 18px;
            user-select: none; -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none;
            
        }

    .cards{
        display: flex;
        justify-content: center;
        margin-top: 35px;
        padding: 0 1px;
    }
    
    .card{
        background: rgba(0,0,0,0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 15px;
        padding: 5px;
        max-width: 400px;
        width: 100%;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        position: relative;
        z-index: 10;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.4);
    }
    
    .title{
        font-size: 18px;
        text-align: center;
        color: white;
        font-weight: 600;
        margin: 0;
        line-height: 1.4;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        letter-spacing: 0.5px;
    }
        .card p{
            color:rgba(255,255,255,0.7);
            text-align: left;
            margin:0;
        }
        .card a{
            color: rgba(255,255,255,0.9);
            font-size:15px;
        padding:50px;
            margin:10px;
            border: 2px solid rgba(255,255,255,0.9);
            
        }
    </style>
</head>
<body>
    <div class="header">
        <h3>Live management system</h3>
    </div>
    <div class="selector">
        <div class="btn">
            <p>Live</p>
        </div>
        <div class="btn">
            <p>Upcoming</p>
        </div>
        <div class="btn">
            <p>Completed</p>
        </div>
    </div>
    <div class="cards">
        <div class="card">
            <h3 class="title">
      Print Culture and mordern world          
            </h3>
            <p>
      AARAMBH 2.O 10th BATCH 25-26
            </p>
            <a>Join Now</a>
            </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.waves.min.js"></script>
    
    <script>
    VANTA.WAVES({
        el: "body",
        mouseControls: false,
        touchControls: false,
        gyroControls: false,
        minHeight: 200.00,
        minWidth: 200.00,
        scale: 1.00,
        scaleMobile: 1.00,
        color: 0x000000,
        shininess: 180.00,
        waveHeight: 25.00,
        waveSpeed: 0.6,
        zoom: 0.65,
        material: {
            options: {
                fog: true,
                wireframe: true
            }
        },
        forceAnimate: true
    })
    </script>
</body>
</html>

