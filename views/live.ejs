<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Management System</title>
    <style>
        body {
            /* Vanta fix: ensures the body covers the entire viewport */
            background-color: black;
            margin: 0; 
            padding: 0;
            min-height: 100vh; 
            width: 100vw;
        }

        /* Set a z-index on content containers to ensure they appear above Vanta */
        .header, .selector {
            position: relative; /* Necessary to use z-index */
            z-index: 10; /* Ensures content is layered above the Vanta canvas */
        }
        
        .header {
            padding-top: 20px;
        }
        
        h3 {
            text-align: center;
            font-family: 'Arial', sans-serif;
            font-size: 20px;
            color: white;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
            margin: 0;
            margin-bottom: 20px;
        }
        
        .selector {
            width: 100%;
            min-width: 250px;
            max-width: 300px;
            height: 72px;
            display: flex;
            justify-content: space-between;
            padding: 10px;
            /* Center the selector element horizontally */
            margin-left: auto; 
            margin-right: auto;
        }
        
        .btn {
            padding: 7px;
            background: #454545;
            display: flex;
            justify-content: center;
            outline: none;
            -webkit-tap-highlight-color: transparent;
            align-items: center;
            height: 30px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s;
        }

        .btn:hover {
            background: #606060;
        }

        .btn.active {
            background: linear-gradient(135deg, #667eea, #764ba2);
            transform: scale(1.05);
        }

        .class-section {
            display: none;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
        }

        .class-section.active {
            display: flex;
        }
        
        .btn p {
            color: white;
            font-size: 18px;
            user-select: none; -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none;
            
        }

    .cards{
        display: flex;
        justify-content: center;
        flex-wrap:wrap;
        margin-top: 35px;
        padding: 0 10px;
        gap:10px;
    }
    
    .card{
        background: rgba(0,0,0,0.9);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 15px;
        padding: 5px;
        max-width: 400px;
        width: 100%;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        position: relative;
        z-index: 10;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.4);
    }
    
    .title{
        font-size: 16px;
        text-align: center;
        color: white;
        font-weight: 500;
        margin: 0;
        line-height: 1.4;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
        letter-spacing: 0.5px;
    }
        .card p{
            color:rgba(255,255,255,0.7);
            text-align: left;
            margin-top: 9px;
            margin-bottom: 20px;
            font-size: 14px;
            line-height: 1.5;
        }
        
        .card a{
            display: inline-block;
            width:90%;
            color: white;
            font-size: 16px;
            font-weight: 600;
            padding: 10px 10px;
            margin: 5px 5px;
            background: linear-gradient(135deg, rgba(255,255,255,0.15), rgba(255,255,255,0.05));
            border: 2px solid rgba(255,255,255,0.3);
            border-radius: 5px;
            text-decoration: none;
            text-align: center;
            backdrop-filter: blur(5px);
            transition: all 0.3s ease;
            cursor: pointer;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            user-select: none; -webkit-user-select: none; -moz-user-select: none; -ms-user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        
        .card a:hover {
            background: linear-gradient(135deg, rgba(255,255,255,0.25), rgba(255,255,255,0.1));
            border-color: rgba(255,255,255,0.6);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
            color: white;
        }
        
        .card a:active {
            transform: translateY(0);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
            </style>
</head>
<body>
    <div class="header">
        <h3>Live management system</h3>
    </div>
    <div class="selector">
        <div class="btn active" id="liveBtn">
            <p>Live</p>
        </div>
        <div class="btn" id="upcomingBtn">
            <p>Upcoming</p>
        </div>
        <div class="btn" id="completedBtn">
            <p>Completed</p>
        </div>
    </div>
    <div class="cards" id="cardsContainer">
        <!-- Live Classes -->
        <div class="live-cards class-section active">
            <% data.forEach(session => { %>
            <div class="card">
                <h3 class="title">
                    <%= session.title %>       
                </h3>
                <p>
                   <%=session.batch%>
                </p>
                <a href="<%= session.link.replace('https://www.rolexcoderz.xyz/Player/?url=','') %>">
                    Join Live
                </a>
            </div>
            <% }); %>
            <% if (data.length === 0) { %>
            <div class="card">
                <h3 class="title">No Live Classes</h3>
                <p>There are no live classes at the moment.</p>
            </div>
            <% } %>
        </div>

        <!-- Upcoming Classes -->
        <div class="upcoming-cards class-section">
            <% updata.forEach(session => { %>
            <div class="card">
                <h3 class="title">
                    <%= session.title %>       
                </h3>
                <p>
              <%=session.batch%>
                </p>
                <a href="<%= session.link.replace('https://www.rolexcoderz.xyz/Player/?url=','') %>">
                    View Details
                </a>
            </div>
            <% }); %>
            <% if (updata.length === 0) { %>
            <div class="card">
                <h3 class="title">No Upcoming Classes</h3>
                <p>There are no upcoming classes scheduled.</p>
            </div>
            <% } %>
        </div>

        <!-- Completed Classes -->
        <div class="completed-cards class-section">
            <% comdata.forEach(session => { %>
            <div class="card">
                <h3 class="title">
                    <%= session.title %>       
                </h3>
                <p>
                    <%=session.batch%>
                </p>
                <a href="<%= session.link.replace('https://www.rolexcoderz.xyz/Player/?url=','') %>">
                    Watch Recording
                </a>
            </div>
            <% }); %>
            <% if (comdata.length === 0) { %>
            <div class="card">
                <h3 class="title">No Completed Classes</h3>
                <p>There are no completed classes available.</p>
            </div>
            <% } %>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r134/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/vanta@latest/dist/vanta.waves.min.js"></script>
    
    <script>
    VANTA.WAVES({
        el: "body",
        mouseControls: false,
        touchControls: false,
        gyroControls: false,
        minHeight: 200.00,
        minWidth: 200.00,
        scale: 1.00,
        scaleMobile: 1.00,
        color: 0x000000,
        shininess: 180.00,
        waveHeight: 25.00,
        waveSpeed: 0.6,
        zoom: 0.65,
        material: {
            options: {
                fog: true,
                wireframe: true
            }
        },
        forceAnimate: true
    });

    // Button switching functionality
    document.addEventListener('DOMContentLoaded', function() {
        const liveBtn = document.getElementById('liveBtn');
        const upcomingBtn = document.getElementById('upcomingBtn');
        const completedBtn = document.getElementById('completedBtn');
        
        const liveCards = document.querySelector('.live-cards');
        const upcomingCards = document.querySelector('.upcoming-cards');
        const completedCards = document.querySelector('.completed-cards');
        
        const buttons = [liveBtn, upcomingBtn, completedBtn];
        const sections = [liveCards, upcomingCards, completedCards];

        function switchSection(activeIndex) {
            // Remove active class from all buttons and sections
            buttons.forEach(btn => btn.classList.remove('active'));
            sections.forEach(section => section.classList.remove('active'));
            
            // Add active class to selected button and section
            buttons[activeIndex].classList.add('active');
            sections[activeIndex].classList.add('active');
        }

        liveBtn.addEventListener('click', () => switchSection(0));
        upcomingBtn.addEventListener('click', () => switchSection(1));
        completedBtn.addEventListener('click', () => switchSection(2));
    });
    </script>
</body>
</html>

