<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Hello, World!</title>
  <style>

    body {
      background: black;
      margin: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .platform {
      width: 100%;
      padding-bottom: 100px;
    }

    .response-container {
      display: flex;
      flex-direction: row;
      align-items: flex-start;
      margin: 0.5rem;
      width: 90%;
      gap: 0.5rem;
    }

    .question-container {
      display: flex;
      flex-direction: row-reverse;
      align-items: flex-start;
      margin: 0.5rem;
      margin-left: 8%;
      width: 90%;
      gap: 0.5rem;
    }

    .response-wrapper {
      display: flex;
      align-items: center;
      width: 100%;
    }

    .question-wrapper {
      display: flex;
      align-items: center;
      width: 100%;
    }

    .profile-section {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.3rem;
      min-width: 80px;
      flex-shrink: 0;
    }

    .response {
      display: flex;
      align-items: center;
      padding: 1.5rem;
      min-height:72px;
      height:auto;
      backdrop-filter: blur(20px) saturate(180%);
      -webkit-backdrop-filter: blur(20px) saturate(180%);
      border: 1px solid rgba(255, 255, 255, 0.15);
      position: relative;
      flex: 1;
      background-color: rgba(148, 0, 211, 0.19);
      color: #ffffffdd;
          background: rgba(255, 0, 60, 0.17);
          border: 1px solid #ff003c;
          border-radius: 20px;
          padding: 0.6rem 1.5rem;
          margin-bottom: 1.5rem;
          backdrop-filter: blur(15px);
      
    }

    .question {
      display: flex;
      align-items: center;
      padding: 1.5rem;
      min-height:72px;
      height:auto;
      border-radius: 20px;
      border: 2px solid rgba(0, 173, 255, 0.2);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
      position: relative;
      flex: 1;
      background-color: rgba(0, 173, 255, 0.2);
      color: #ffffffcc;
    }

    .response:hover,
    .question:hover {
      transform: scale(1.02);
    }

    .profile-icon {
      width: 50px;
      height: 50px;
      border-radius: 100%;
      object-fit: cover;
      background-color: #888;
      transition: transform 0.3s ease-in-out;
      flex-shrink: 0;
    }

    .profile-icon:hover {
      transform: scale(1.1);
    }

    .response-text h3 {
      font-size: 1rem;
      line-height: 1.5;
      overflow: hidden;
      word-break: break-word; 
    }

    .question-text h3 {
      font-size: 1rem;
      line-height: 1.5;
    }


    .assistant-name,
    .user-name {
      font-size: 0.7rem;
      font-weight: bold;
      text-align: center;
      margin: 0;
      padding: 0;
      white-space: nowrap;
    }

    .assistant-name {
      color: #ff6b81;
    }

    .user-name {
      color: #00bfff;
    }

    .input {
      display: flex;

      align-items: center;
      justify-content: space-between;
      width: 100%;
      max-width:600px;
      padding: 10px 15px;
      position: fixed;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%); 
      box-sizing: border-box;
      gap: 10px;
      flex-wrap: nowrap;
    }

    .inputs {
      flex: 1;
      border-radius: 5px;
      color: white;
      background-color: rgba(255, 255, 255, 0.1);
      padding: 10px 15px;
      border: none;
      outline: none;
      font-size: 1rem;
      min-width: 0;
    }

    .send {
      height: 48px;
      padding: 0 20px;
      border-radius: 50px;
      border: none;
      background: rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      color: white;
      font-weight: bold;
      font-size: 14px;
      cursor: pointer;
      transition: background 0.3s ease;
      white-space: nowrap;
    }

    .send:hover {
      background: rgba(255, 255, 255, 0.2);
    }

    @media (max-width: 600px) {
      .response,
      .question {
        max-width: 90%;
        padding: 1rem;
      }
    }
  </style>
</head>
<body>
  <div class="platform">
    <div class="response-container">
      <div class="profile-section">
        <img class="profile-icon" src="https://bing.com/th/id/BCO.b69f0dfc-0699-40fe-be1d-f6c4a1601c19.png" alt="Blaze AI Icon" />
        <div class="assistant-name">Blaze AI</div>
      </div>
      <div class="response-wrapper">
        <div class="response">
          <div class="response-text">
            <h3>Hi, how can I help you today?</h3>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="input">
    <input class="inputs" type="text" placeholder="Type your question" />
    <button class="send">Send</button>
  </div>

  <script>
    const sendbtn = document.querySelector('.send');
    const inputElement = document.querySelector('.inputs');
    const platform = document.querySelector('.platform');
    let answer;

    async function Ai(question) {
      try {
        const response = await fetch(`/aiquestion`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ question: question })
        });
        const data = await response.json();
        answer = data;
 answer = answer.replace(/(?:\r\n|\r|\n)/g, '<br>');
        platform.innerHTML += `
          <div class="response-container">
            <div class="profile-section">
              <img class="profile-icon" src="https://bing.com/th/id/BCO.b69f0dfc-0699-40fe-be1d-f6c4a1601c19.png" alt="Blaze AI Icon" />
              <div class="assistant-name">Blaze AI</div>
            </div>
            <div class="response-wrapper">
              <div class="response">
                <div class="response-text">
                  <h3>${answer}</h3>
                </div>
              </div>
            </div>
          </div>
        `;
      } catch (error) {
        console.error("Error fetching AI response:", error);
        answer = "Sorry, I couldn't get an answer right now.";
      }
    }

    sendbtn.addEventListener('click', () => {
      if (inputElement.value.trim()) {
        const question = inputElement.value;

        const questionContainer = document.createElement('div');
        questionContainer.classList.add('question-container');
        questionContainer.innerHTML = `
          <div class="profile-section">
            <img class="profile-icon" src="https://bing.com/th/id/BCO.f651cfa5-0602-41ab-8a9f-ae66061154ea.png" alt="User Icon" />
            <div class="user-name">User</div>
          </div>
          <div class="question-wrapper">
            <div class="question">
              <div class="question-text">
                <h3>${question}</h3>
              </div>
            </div>
          </div>
        `;
        platform.appendChild(questionContainer);
        inputElement.value = '';

        Ai(question);
      }
    });

    inputElement.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        sendbtn.click();
      }
    });
  </script>
</body>
</html>