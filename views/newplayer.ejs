<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>M3U8 Video Player</title>
    <script src="https://cdn.jsdelivr.net/npm/hls.js@latest"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
            background: #000;
            color: #fff;
            overflow-x: hidden;
        }
        .user-info {
            background-color: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid #3e3e3e;
            border-radius: 10px;
            padding: 20px;
            margin: 20px auto;
            /* Center the section */
            width: 80%;
            /* Adjust width as needed */
            max-width: 600px;
            /* Set a maximum width */
            color: white;
            text-align: center;
            z-index: 1000;
        }

        .user-info h3 {
            background: linear-gradient(to right, #0011ff, #2575FC);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 2em;
            margin-bottom: 10px;
        }
        .player-container {
            position: relative;
            width: calc(100vw - 40px);
            max-width: 720px;
            height: 60vh;
            margin: 20px auto;
            background: transparent;
            border: 1px solid #333;
            border-radius: 16px;
            box-shadow: 0 6px 16px rgba(0,0,0,0.7);
            overflow: hidden;
        }
        video {
            width: 100%;
            height: 100%;
            object-fit: contain;
            border-radius: 16px;
        }
        .controls {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(20,20,20,0.8), transparent);
            padding: 14px 16px;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            max-height: 100px;
            border-radius: 12px;
            transition: opacity 0.4s ease-in-out;
            opacity: 0;
            z-index: 20;
        }
        .player-container:hover .controls, .player-container.active-controls .controls {
            opacity: 1;
        }
        button {
            background: transparent;
            border: none;
            color: #fff;
            cursor: pointer;
            font-size: 24px;
            padding: 12px;
            border-radius: 8px;
            transition: all 0.3s ease;
        }
        button:hover {
            color: #00c4cc;
            background: rgba(0,196,204,0.25);
            transform: scale(1.1);
            box-shadow: 0 3px 10px rgba(0,0,0,0.5);
        }
        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .left-controls, .right-controls {
            display: flex;
            align-items: center;
            gap: 18px;
            flex: 1;
        }
        .time-display {
            font-size: 16px;
            font-weight: 600;
            white-space: nowrap;
        }
        .volume-container {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .volume-slider {
            width: 100px;
            -webkit-appearance: none;
            height: 6px;
            background: #fff;
            border-radius: 4px;
            outline: none;
            transition: background 0.3s ease;
        }
        .volume-slider::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 16px;
            height: 16px;
            background: #00c4cc;
            border-radius: 50%;
            cursor: pointer;
            box-shadow: 0 0 8px rgba(0,196,204,0.6);
        }
        .settings-menu {
            position: absolute;
            bottom: 100px;
            right: 16px;
            background: rgba(20,20,20,0.9);
            border: 1px solid #333;
            border-radius: 12px;
            padding: 12px;
            display: none;
            flex-direction: column;
            gap: 10px;
            z-index: 30;
            box-shadow: 0 6px 16px rgba(0,0,0,0.7);
        }
        .settings-menu.active {
            display: flex;
        }
        .settings-menu label {
            font-size: 16px;
            font-weight: 600;
        }
        .dropdown {
            position: relative;
            display: inline-block;
        }
        .dropdown-toggle {
            background: transparent;
            color: #fff;
            border: none;
            font-size: 16px;
            font-weight: 500;
            padding: 6px 10px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .dropdown-toggle:hover {
            background: rgba(0,196,204,0.25);
            color: #00c4cc;
        }
        .dropdown-menu {
            position: absolute;
            bottom: 100%;
            left: 0;
            background: rgba(20,20,20,0.9);
            border: 1px solid #333;
            border-radius: 8px;
            display: none;
            flex-direction: column;
            width: 120px;
            z-index: 31;
            box-shadow: 0 6px 16px rgba(0,0,0,0.7);
        }
        .dropdown-menu.active {
            display: flex;
        }
        .dropdown-item {
            padding: 10px 14px;
            font-size: 15px;
            font-weight: 500;
            color: #fff;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .dropdown-item:hover {
            background: rgba(0,196,204,0.25);
            color: #00c4cc;
        }
        .progress-container {
            position: absolute;
            bottom: 85px;
            left: 0;
            right: 0;
            margin: 0 16px;
            height: 10px;
            background: linear-gradient(to right, rgba(255,255,255,0.15), rgba(255,255,255,0.1));
            border-radius: 5px;
            cursor: pointer;
            z-index: 21;
            transition: transform 0.3s ease, bottom 0.3s ease;
        }
        .player-container:not(.active-controls) .progress-container {
            bottom: 24px;
        }
        .player-container.active-controls .settings-menu.active ~ .progress-container {
            bottom: 160px;
        }
        .progress-container:hover {
            transform: scaleY(1.4);
        }
        .buffer-bar {
            height: 100%;
            background: rgba(255,255,255,0.25);
            border-radius: 5px;
            position: absolute;
            top: 0;
            left: 0;
            transition: width 0.2s ease;
        }
        .progress-bar {
            height: 100%;
            background: linear-gradient(to right, #00c4cc, #00969c);
            border-radius: 5px;
            position: absolute;
            top: 0;
            left: 0;
            box-shadow: 0 0 6px rgba(0,196,204,0.7);
            transition: width 0.2s ease;
        }
        .progress-bar::after {
            content: '';
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 14px;
            height: 14px;
            background: #00c4cc;
            border: 2px solid #fff;
            border-radius: 50%;
            box-shadow: 0 0 8px rgba(0,0,0,0.7);
        }
        .chapter-marker {
            position: absolute;
            top: 0;
            height: 100%;
            width: 1px;
            background: rgba(255,255,255,0.9);
            z-index: 22;
        }
        .progress-tooltip {
            position: absolute;
            bottom: 24px;
            background: rgba(20,20,20,0.9);
            color: #fff;
            padding: 6px 10px;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 500;
            text-shadow: 0 1px 2px rgba(0,0,0,0.5);
            display: none;
            pointer-events: none;
            z-index: 23;
            transition: transform 0.3s ease;
        }
        .progress-container:hover .progress-tooltip {
            display: block;
            transform: translateY(-4px);
        }
        .progress-tooltip::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 50%;
            transform: translateX(-50%);
            border-width: 8px;
            border-style: solid;
            border-color: rgba(20,20,20,0.9) transparent transparent transparent;
        }
        .gesture-area {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
            display: flex;
        }
        .left-half, .right-half {
            width: 50%;
            height: 100%;
        }
        .seek-animation {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            color: #fff;
            font-size: 36px;
            opacity: 0;
            transition: opacity 0.4s ease, transform 0.4s ease;
            pointer-events: none;
            z-index: 15;
            display: flex;
            align-items: center;
            gap: 10px;
            background: rgba(20,20,20,0.9);
            padding: 10px 16px;
            border-radius: 10px;
        }
        .seek-animation.active {
            opacity: 0.95;
            transform: translateY(-50%) scale(1.05);
        }
        .seek-animation.left {
            left: 16px;
        }
        .seek-animation.right {
            right: 16px;
        }
        .player-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-size: 80px;
            color: #fff;
            opacity: 0;
            transition: opacity 0.4s ease;
            z-index: 15;
            cursor: pointer;
            background: transparent;
            padding: 14px;
            border-radius: 12px;
            animation: fadeIn 0.4s ease;
        }
        .player-container.paused .player-overlay {
            opacity: 0.95;
        }
        @keyframes fadeIn {
            from { opacity: 0; transform: translate(-50%, -50%) scale(0.9); }
            to { opacity: 0.95; transform: translate(-50%, -50%) scale(1); }
        }
        .player-container.fullscreen {
            width: 100%;
            height: 100%;
            max-width:600px;
            max-height:600px;
            position: fixed;
            top: 0;
            left: 0;
            margin: 0;
            z-index: 1000;
            border: none;
            border-radius: 0;
            box-shadow: none;
        }
        .player-container.fullscreen video {
            width: 100vw;
            height: 100vh;
            object-fit: contain;
            border-radius: 0;
        }
        .ai-frame-container {
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            max-width: 100%;
            height: 100%;
            background: transparent;
            z-index: 40;
            overflow: hidden;
            transform: translateX(100%);
            transition: transform 0.5s ease, opacity 0.4s ease;
            opacity: 0;
        }
        .ai-frame-container.active {
            transform: translateX(0);
            opacity: 1;
        }
        .ai-frame-container iframe {
            width: 100%;
            height: 100%;
            border: none;
            border-radius: 0;
        }
        .ai-close-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            font-size: 20px;
            padding: 12px;
            background: rgba(20,20,20,0.8);
            border-radius: 50%;
            transition: transform 0.3s ease, background 0.3s ease;
        }
        .ai-close-btn:hover {
            transform: scale(1.1);
            background: rgba(0,196,204,0.25);
        }
        .orientation-prompt {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(20,20,20,0.9);
            color: #fff;
            padding: 18px 32px;
            border-radius: 12px;
            font-size: 18px;
            font-weight: 600;
            z-index: 50;
            display: none;
            box-shadow: 0 6px 16px rgba(0,0,0,0.7);
        }
        .orientation-prompt.active {
            display: block;
        }
        .download-btn {
            position: absolute;
            top: 12px;
            right: 12px;
            font-size: 24px;
            z-index: 25;
            border-radius: 8px;
        }
        .download-dialog {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: rgba(20,20,20,0.9);
            color: #fff;
            padding: 18px;
            border-radius: 12px;
            z-index: 50;
            display: none;
            flex-direction: column;
            gap: 14px;
            font-size: 16px;
            font-weight: 600;
            text-align: center;
            min-width: 240px;
            box-shadow: 0 6px 16px rgba(0,0,0,0.7);
        }
        .download-dialog.active {
            display: flex;
        }
        .download-dialog .copy-confirmation {
            opacity: 1;
            transition: opacity 0.5s ease;
        }
        .download-dialog .copy-confirmation.hidden {
            opacity: 0;
        }
        .download-dialog .buttons {
            display: flex;
            justify-content: center;
            gap: 12px;
        }
        .download-dialog button {
            background: #00c4cc;
            color: #fff;
            padding: 10px 16px;
            font-size: 15px;
            border-radius: 8px;
            transition: background 0.3s ease;
        }
        .download-dialog button:hover {
            background: #00969c;
        }
        @media (max-width: 768px) {
            .player-container {
                width: calc(100vw - 32px);
                height: 50vh;
                margin: 16px auto;
                border-radius: 12px;
            }
            .controls {
                padding: 12px 14px;
                max-height: 90px;
            }
            button {
                font-size: 20px;
                padding: 10px;
            }
            .left-controls, .right-controls {
                gap: 16px;
            }
            .time-display {
                font-size: 14px;
            }
            .volume-slider {
                width: 80px;
            }
            .settings-menu {
                bottom: 90px;
                padding: 10px;
                right: 14px;
            }
            .settings-menu label {
                font-size: 14px;
            }
            .dropdown-toggle {
                font-size: 14px;
                padding: 5px 8px;
            }
            .dropdown-menu {
                width: 100px;
            }
            .dropdown-item {
                font-size: 13px;
                padding: 8px 12px;
            }
            .progress-container {
                height: 8px;
                bottom: 80px;
                margin: 0 14px;
            }
            .player-container:not(.active-controls) .progress-container {
                bottom: 20px;
            }
            .player-container.active-controls .settings-menu.active ~ .progress-container {
                bottom: 150px;
            }
            .progress-tooltip {
                font-size: 14px;
                bottom: 20px;
                padding: 5px 8px;
            }
            .progress-bar::after {
                width: 12px;
                height: 12px;
            }
            .seek-animation {
                font-size: 32px;
                padding: 8px 14px;
            }
            .player-overlay {
                font-size: 70px;
                padding: 12px;
            }
            .orientation-prompt {
                font-size: 16px;
                padding: 14px 28px;
            }
            .download-btn {
                top: 10px;
                right: 10px;
                font-size: 20px;
            }
            .download-dialog {
                padding: 14px;
                font-size: 14px;
                min-width: 200px;
            }
            .download-dialog button {
                padding: 8px 14px;
                font-size: 14px;
            }
            .ai-close-btn {
                top: 10px;
                right: 10px;
                font-size: 18px;
                padding: 10px;
            }
        }
        .viewspeed{
            margin-left:50px;
        }
    </style>
</head>
<body>
    <div class="player-container" id="player-container">

        <div style="position:absolute; display: flex; align-items: center; background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%); padding: 8px 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); overflow: hidden;margin-top:30px;margin-left:20px;">
          <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at 20% 50%, rgba(255,255,255,0.15) 0%, transparent 50%); pointer-events: none;"></div>
          <h3 style="position: relative; color: white; margin: 0; font-size: 1.3em; text-shadow: 1px 1px 3px rgba(0,0,0,0.3); font-weight: 600; letter-spacing: -0.5px;">LearnPulse</h3>
        </div>


        
        <video id="video"></video>
        <button class="download-btn" id="download-btn" onclick="showDownloadDialog()"><i class="fa-solid fa-download"></i></button>
        <div id="gesture-area" class="gesture-area">
            <div class="left-half"></div>
            <div class="right-half"></div>
        </div>
        <div class="progress-container" id="progress-container">
            <div class="buffer-bar" id="buffer-bar"></div>
            <div class="progress-bar" id="progress-bar"></div>
            <div class="chapter-marker" style="left: 25%"></div>
            <div class="chapter-marker" style="left: 50%"></div>
            <div class="chapter-marker" style="left: 75%"></div>
            <div class="progress-tooltip" id="progress-tooltip">00:00</div>
        </div>
        <div class="player-overlay" id="player-overlay" onclick="togglePlayPause()"><i class="fa-solid fa-play"></i></div>
        <div class="orientation-prompt" id="orientation-prompt">Please rotate your device to landscape mode</div>
        <div class="seek-animation left" id="seek-backward"><i class="fa-solid fa-backward"></i> -10s</div>
        <div class="seek-animation right" id="seek-forward"><i class="fa-solid fa-forward"></i> +10s</div>
        <div class="controls" id="controls">
            <div class="left-controls">
                <button onclick="togglePlayPause()" class="play-pause-btn"><i class="fa-solid fa-play"></i></button>
                <div class="time-display" id="time-display">00:00 / 00:00</div>
            </div>
            <div class="right-controls">
                <div class="volume-container">
                    <button class="volume-btn" onclick="toggleMute()"><i class="fa-solid fa-volume-high"></i></button>
                    <input type="range" class="volume-slider" min="0" max="100" value="100">
                </div>
                <div class="settings-toggle">
                    <button class="settings-btn" onclick="toggleSettings()"><i class="fa-solid fa-gear"></i></button>
                    <div id="settings-menu" class="settings-menu">
                        <label for="quality-dropdown">Quality</label>
                        <div class="dropdown" id="quality-dropdown">
                            <button class="dropdown-toggle" id="quality-toggle" onclick="toggleDropdown('quality')">240p</button>
                            <div class="dropdown-menu" id="quality-menu">
                                <div class="dropdown-item" data-value="240p" onclick="selectQuality('240p', '240p')">240p</div>
                                <div class="dropdown-item" data-value="360p" onclick="selectQuality('360p', '360p')">360p</div>
                                <div class="dropdown-item" data-value="480p" onclick="selectQuality('480p', '480p')">480p</div>
                                <div class="dropdown-item" data-value="720p" onclick="selectQuality('720p', '720p')">720p</div>
                            </div>
                        </div>
                        <label for="speed-dropdown">Speed</label>
                        <div class="dropdown" id="speed-dropdown">
                            <input type="range" min="0" max="4" step="0.1" value="1" id="rangeInput">
                            <p id=viewspeed class="viewspeed">Speed:1</p>
                            </div>
                        </div>
                    </div>
                </div>
                <button onclick="toggleAIFrame()" class="ai-btn"><i class="fa-solid fa-robot"></i></button>
                <button onclick="toggleFullScreen()" class="fullscreen-btn"><i class="fa-solid fa-expand"></i></button>
            </div>
        
        <div class="download-dialog" id="download-dialog">
            <span class="copy-confirmation" id="copy-confirmation">URL copied to clipboard!</span>
            <span id="download-prompt">Go to download panel?</span>
            <div class="buttons">
                <button onclick="redirectToDownload()">Yes</button>
                <button onclick="hideDownloadDialog()">No</button>
            </div>
        </div>
        <div class="ai-frame-container" id="ai-frame-container">
            <button class="ai-close-btn" onclick="toggleAIFrame()"><i class="fa-solid fa-times"></i></button>
            <iframe src="https://learn-pulse-nxt.onrender.com/ai" allowfullscreen></iframe>
        </div>
    </div>

    <span class="user-info">
        <h3 id="userNameDisplay"><%=title%></h3>
    </span>
    <script>
        let hls;
        const video = document.getElementById('video');
        const playerContainer = document.getElementById('player-container');
        const qualityToggle = document.getElementById('quality-toggle');
        const qualityMenu = document.getElementById('quality-menu');
        const speedToggle = document.getElementById('speed-toggle');
        const speedMenu = document.getElementById('speed-menu');
        const gestureArea = document.getElementById('gesture-area');
        const leftHalf = document.querySelector('.left-half');
        const rightHalf = document.querySelector('.right-half');
        const progressContainer = document.getElementById('progress-container');
        const progressBar = document.getElementById('progress-bar');
        const bufferBar = document.getElementById('buffer-bar');
        const timeDisplay = document.getElementById('time-display');
        const playPauseBtn = document.querySelector('.play-pause-btn');
        const volumeSlider = document.querySelector('.volume-slider');
        const volumeBtn = document.querySelector('.volume-btn');
        const settingsMenu = document.getElementById('settings-menu');
        const range= document.getElementById('rangeInput');
        const currentspeed = document.getElementById('viewspeed');
        const aiFrameContainer = document.getElementById('ai-frame-container');
        const controls = document.getElementById('controls');
        const playerOverlay = document.getElementById('player-overlay');
        const orientationPrompt = document.getElementById('orientation-prompt');
        const progressTooltip = document.getElementById('progress-tooltip');
        const seekBackward = document.getElementById('seek-backward');
        const seekForward = document.getElementById('seek-forward');
        const downloadDialog = document.getElementById('download-dialog');
        const downloadBtn = document.getElementById('download-btn');
        const copyConfirmation = document.getElementById('copy-confirmation');
        const downloadPrompt = document.getElementById('download-prompt');
        const defaultUrl = '<%=url%>';
        let currentM3u8Url = defaultUrl;
        const qualityMap = {
            '240p': 'index_1.m3u8',
            '360p': 'index_2.m3u8',
            '480p': 'index_3.m3u8',
            '720p': 'index_4.m3u8'
        };
        let controlsTimer;
        let isDragging = false;

        function formatTime(seconds) {
            if (isNaN(seconds)) return '00:00';
            const hours = Math.floor(seconds / 3600);
            const minutes = Math.floor((seconds % 3600) / 60);
            const secs = Math.floor(seconds % 60);
            return `${hours.toString().padStart(2, '0')}:${minutes.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
        }

        function loadVideo(url, resumeTime = 0, wasPlaying = false) {
            if (!url) return;
            if (hls) hls.destroy();
            if (Hls.isSupported()) {
                hls = new Hls();
                hls.loadSource(url);
                hls.attachMedia(video);
                hls.on(Hls.Events.MANIFEST_PARSED, function() {
                    video.currentTime = resumeTime;
                    if (wasPlaying) {
                        video.play().then(() => {
                            playPauseBtn.innerHTML = '<i class="fa-solid fa-pause"></i>';
                            playerOverlay.innerHTML = '<i class="fa-solid fa-pause"></i>';
                            playerOverlay.style.opacity = 0;
                            playerContainer.classList.remove('paused');
                        }).catch(e => {
                            console.log('Autoplay prevented:', e);
                            playPauseBtn.innerHTML = '<i class="fa-solid fa-play"></i>';
                            playerOverlay.innerHTML = '<i class="fa-solid fa-play"></i>';
                            playerOverlay.style.opacity = 0.95;
                            playerContainer.classList.add('paused');
                        });
                    } else {
                        playPauseBtn.innerHTML = '<i class="fa-solid fa-play"></i>';
                        playerOverlay.innerHTML = '<i class="fa-solid fa-play"></i>';
                        playerOverlay.style.opacity = 0.95;
                        playerContainer.classList.add('paused');
                    }
                });
            } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                video.src = url;
                video.currentTime = resumeTime;
                if (wasPlaying) {
                    video.play().then(() => {
                        playPauseBtn.innerHTML = '<i class="fa-solid fa-pause"></i>';
                        playerOverlay.innerHTML = '<i class="fa-solid fa-pause"></i>';
                        playerOverlay.style.opacity = 0;
                        playerContainer.classList.remove('paused');
                    }).catch(e => {
                        console.log('Autoplay prevented:', e);
                        playPauseBtn.innerHTML = '<i class="fa-solid fa-play"></i>';
                        playerOverlay.innerHTML = '<i class="fa-solid fa-play"></i>';
                        playerOverlay.style.opacity = 0.95;
                        playerContainer.classList.add('paused');
                    });
                } else {
                    playPauseBtn.innerHTML = '<i class="fa-solid fa-play"></i>';
                    playerOverlay.innerHTML = '<i class="fa-solid fa-play"></i>';
                    playerOverlay.style.opacity = 0.95;
                    playerContainer.classList.add('paused');
                }
            }
        }

        function toggleDropdown(type) {
            const menu = type === 'quality' ? qualityMenu : speedMenu;
            menu.classList.toggle('active');
            event.stopPropagation();
        }

        function selectQuality(value, label) {
            qualityToggle.textContent = label;
            qualityMenu.classList.remove('active');
            const wasPlaying = !video.paused;
            const currentTime = video.currentTime;
            const newUrl = currentM3u8Url.replace(/index_\d+\.m3u8/, qualityMap[value]);
            currentM3u8Url = newUrl;
            loadVideo(currentM3u8Url, currentTime, wasPlaying);
        }

        range.addEventListener("input",()=>{
            const inputspeed=range.value;
            video.playbackRate=inputspeed;
            currentspeed.textContent=`speed:${inputspeed}`;
        });
        function togglePlayPause() {
            if (video.paused) {
                video.play();
                playPauseBtn.innerHTML = '<i class="fa-solid fa-pause"></i>';
                playerOverlay.innerHTML = '<i class="fa-solid fa-pause"></i>';
                playerOverlay.style.opacity = 0;
                playerContainer.classList.remove('paused');
            } else {
                video.pause();
                playPauseBtn.innerHTML = '<i class="fa-solid fa-play"></i>';
                playerOverlay.innerHTML = '<i class="fa-solid fa-play"></i>';
                playerOverlay.style.opacity = 0.95;
                playerContainer.classList.add('paused');
            }
        }

        function toggleMute() {
            video.muted = !video.muted;
            updateVolumeIcon();
        }

        function updateVolumeIcon() {
            if (video.muted || video.volume === 0) {
                volumeBtn.innerHTML = '<i class="fa-solid fa-volume-mute"></i>';
            } else if (video.volume < 0.5) {
                volumeBtn.innerHTML = '<i class="fa-solid fa-volume-low"></i>';
            } else {
                volumeBtn.innerHTML = '<i class="fa-solid fa-volume-high"></i>';
            }
        }

        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                playerContainer.requestFullscreen().then(() => {
                    console.log('Entered fullscreen');
                    playerContainer.classList.add('fullscreen');
                    if (screen.orientation && screen.orientation.lock) {
                        screen.orientation.lock('landscape').then(() => {
                            console.log('Orientation locked to landscape');
                        }).catch(err => {
                            console.log(`Failed to lock orientation: ${err.message}`);
                            orientationPrompt.classList.add('active');
                            setTimeout(() => {
                                orientationPrompt.classList.remove('active');
                            }, 3000);
                        });
                    } else {
                        orientationPrompt.classList.add('active');
                        setTimeout(() => {
                            orientationPrompt.classList.remove('active');
                        }, 3000);
                    }
                }).catch(err => {
                    console.log(`Error enabling fullscreen: ${err.message}`);
                });
            } else {
                document.exitFullscreen().then(() => {
                    console.log('Exited fullscreen');
                    playerContainer.classList.remove('fullscreen');
                    if (screen.orientation && screen.orientation.unlock) {
                        screen.orientation.unlock();
                    }
                    orientationPrompt.classList.remove('active');
                }).catch(err => {
                    console.log(`Error exiting fullscreen: ${err.message}`);
                });
            }
        }

        function handleOrientationChange() {
            if (document.fullscreenElement && window.innerWidth < window.innerHeight) {
                orientationPrompt.classList.add('active');
                setTimeout(() => {
                    orientationPrompt.classList.remove('active');
                }, 3000);
            } else {
                orientationPrompt.classList.remove('active');
            }
        }

        function toggleSettings() {
            settingsMenu.classList.toggle('active');
            qualityMenu.classList.remove('active');
            speedMenu.classList.remove('active');
            event.stopPropagation();
        }

        function toggleAIFrame() {
            aiFrameContainer.classList.toggle('active');
            if (aiFrameContainer.classList.contains('active')) {
                video.pause();
                playPauseBtn.innerHTML = '<i class="fa-solid fa-play"></i>';
                playerOverlay.innerHTML = '<i class="fa-solid fa-play"></i>';
                playerOverlay.style.opacity = 0.95;
                playerContainer.classList.add('paused');
            }
            else{
                video.play();
                playPauseBtn.innerHTML = '<i class="fa-solid fa-pause"></i>';
                playerOverlay.innerHTML = '<i class="fa-solid fa-pause"></i>';
                playerOverlay.style.opacity = 0;
                playerContainer.classList.remove('paused');
            }
            
            event.stopPropagation();
        }

        function showDownloadDialog() {
            downloadBtn.disabled = true;
            navigator.clipboard.writeText(currentM3u8Url).then(() => {
                console.log('M3U8 URL copied to clipboard');
                copyConfirmation.classList.remove('hidden');
                downloadPrompt.classList.add('hidden');
                downloadDialog.classList.add('active');
                setTimeout(() => {
                    copyConfirmation.classList.add('hidden');
                    downloadPrompt.classList.remove('hidden');
                    downloadBtn.disabled = false;
                }, 2000);
            }).catch(err => {
                console.log('Failed to copy URL:', err);
                copyConfirmation.textContent = 'Failed to copy URL';
                copyConfirmation.classList.remove('hidden');
                downloadPrompt.classList.add('hidden');
                downloadDialog.classList.add('active');
                setTimeout(() => {
                    copyConfirmation.classList.add('hidden');
                    downloadPrompt.classList.remove('hidden');
                    copyConfirmation.textContent = 'URL copied to clipboard!';
                    downloadBtn.disabled = false;
                }, 2000);
            });
        }

        function redirectToDownload() {
            downloadBtn.disabled = false;
            window.location.href = 'https://m3u8.dev';
        }

        function hideDownloadDialog() {
            downloadDialog.classList.remove('active');
            copyConfirmation.classList.add('hidden');
            downloadPrompt.classList.remove('hidden');
            downloadBtn.disabled = false;
        }

        function showControls() {
            playerContainer.classList.add('active-controls');
            clearTimeout(controlsTimer);
            if (!video.paused) {
                controlsTimer = setTimeout(() => {
                    playerContainer.classList.remove('active-controls');
                }, 3000);
            }
        }

        function updateProgress(e) {
            const rect = progressContainer.getBoundingClientRect();
            const pos = (e.clientX - rect.left) / rect.width;
            const time = pos * video.duration;
            video.currentTime = Math.max(0, Math.min(time, video.duration));
        }

        progressContainer.addEventListener('mousemove', (e) => {
            const rect = progressContainer.getBoundingClientRect();
            const pos = (e.clientX - rect.left) / rect.width;
            const time = pos * video.duration;
            progressTooltip.textContent = formatTime(time);
            const tooltipWidth = progressTooltip.offsetWidth;
            let left = e.clientX - rect.left - tooltipWidth / 2;
            left = Math.max(0, Math.min(left, rect.width - tooltipWidth));
            progressTooltip.style.left = `${left}px`;
            if (isDragging) {
                updateProgress(e);
            }
        });

        progressContainer.addEventListener('mousedown', (e) => {
            isDragging = true;
            updateProgress(e);
        });

        document.addEventListener('mouseup', () => {
            isDragging = false;
        });

        document.addEventListener('mousemove', (e) => {
            if (isDragging) {
                updateProgress(e);
            }
        });

        progressContainer.addEventListener('mouseleave', () => {
            isDragging = false;
        });

        progressContainer.addEventListener('click', updateProgress);

        video.addEventListener('loadedmetadata', () => {
            timeDisplay.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
            video.volume = volumeSlider.value / 100;
            updateVolumeIcon();
        });

        video.addEventListener('timeupdate', () => {
            const progress = (video.currentTime / video.duration) * 100;
            progressBar.style.width = `${progress}%`;
            timeDisplay.textContent = `${formatTime(video.currentTime)} / ${formatTime(video.duration)}`;
        });

        video.addEventListener('progress', () => {
            if (video.buffered.length > 0) {
                const buffered = (video.buffered.end(0) / video.duration) * 100;
                bufferBar.style.width = `${buffered}%`;
            }
        });

        volumeSlider.addEventListener('input', () => {
            video.volume = volumeSlider.value / 100;
            video.muted = false;
            updateVolumeIcon();
        });

        video.addEventListener('volumechange', updateVolumeIcon);

        let tapTimer, tapCount = 0, holdTimer;

        function handleTap(side) {
            tapCount++;
            if (tapCount === 1) {
                tapTimer = setTimeout(() => { tapCount = 0; }, 300);
            } else if (tapCount === 2) {
                clearTimeout(tapTimer);
                tapCount = 0;
                const seekAmount = 10;
                if (side === 'left') {
                    video.currentTime = Math.max(0, video.currentTime - seekAmount);
                    seekBackward.classList.add('active');
                    setTimeout(() => {
                        seekBackward.classList.remove('active');
                    }, 600);
                } else if (side === 'right') {
                    video.currentTime = Math.min(video.duration, video.currentTime + seekAmount);
                    seekForward.classList.add('active');
                    setTimeout(() => {
                        seekForward.classList.remove('active');
                    }, 600);
                }
            }
        }

        function startHold() {
            holdTimer = setTimeout(() => {
                video.playbackRate = 2;
            }, 500);
        }

        function endHold() {
            clearTimeout(holdTimer);
            if (video.playbackRate === 2) {
                video.playbackRate = parseFloat(speedToggle.textContent.replace('x', '')) || 1;
            }
        }

        leftHalf.addEventListener('touchstart', startHold);
        leftHalf.addEventListener('touchend', endHold);
        leftHalf.addEventListener('touchend', () => handleTap('left'));

        rightHalf.addEventListener('touchstart', startHold);
        rightHalf.addEventListener('touchend', endHold);
        rightHalf.addEventListener('touchend', () => handleTap('right'));

        gestureArea.addEventListener('touchstart', (e) => e.preventDefault(), { passive: false });

        document.addEventListener('click', (e) => {
            if (!settingsMenu.contains(e.target) && !e.target.closest('.settings-btn')) {
                settingsMenu.classList.remove('active');
                qualityMenu.classList.remove('active');
                speedMenu.classList.remove('active');
            }
            if (!aiFrameContainer.contains(e.target) && !e.target.closest('.ai-btn') && !e.target.closest('.ai-close-btn')) {
                aiFrameContainer.classList.remove('active');
            }
            if (!downloadDialog.contains(e.target) && !e.target.closest('.download-btn')) {
                downloadDialog.classList.remove('active');
                copyConfirmation.classList.add('hidden');
                downloadPrompt.classList.remove('hidden');
                downloadBtn.disabled = false;
            }
        });

        playerContainer.addEventListener('mousemove', showControls);
        playerContainer.addEventListener('touchstart', showControls);

        video.addEventListener('pause', () => {
            playerContainer.classList.add('paused');
            showControls();
        });
        video.addEventListener('play', () => {
            playerContainer.classList.remove('paused');
            showControls();
        });

        window.addEventListener('orientationchange', handleOrientationChange);
        window.addEventListener('resize', handleOrientationChange);

        window.onload = () => loadVideo(currentM3u8Url);
    </script>
</body>
</html>